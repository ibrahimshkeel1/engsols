# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Site URL for auth redirects and email links (required in production)
NEXT_PUBLIC_SITE_URL=https://engsols.com

# Email via Resend (optional — skips in dev without key)
RESEND_API_KEY=
EMAIL_FROM=EngSols <notifications@engsols.com>

# Web push (optional)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@engsols.com

# LiveKit video (optional)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=

# Error tracking (optional)
NEXT_PUBLIC_SENTRY_DSN=

# Analytics (optional)
NEXT_PUBLIC_GA_ID=

# AI career assist (optional — falls back to rule-based matching)
OPENAI_API_KEY=

# Require confirmed email before login (optional — set to "true" in production)
ENFORCE_EMAIL_VERIFICATION=

# E2E authenticated tests (optional)
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
